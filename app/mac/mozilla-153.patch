+
+// static
+bool nsCocoaUtils::HasTouchScreen() {
+  NS_OBJC_BEGIN_TRY_BLOCK_RETURN;
+
+  // -[NSScreen touchCapabilities] is new in macOS 27, so look it up at runtime
+  // rather than requiring the macOS 27 SDK.
+  for (NSScreen* screen in [NSScreen screens]) {
+    if ([screen respondsToSelector:@selector(touchCapabilities)] &&
+        [[screen valueForKey:@"touchCapabilities"] unsignedIntegerValue] != 0) {
+      return true;
+    }
+  }
+  return false;
+
+  NS_OBJC_END_TRY_BLOCK_RETURN(false);
+}
