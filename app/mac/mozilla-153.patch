+void nsCocoaWindow::DispatchDirectTouchPoint(uint32_t aPointerId,
+                                             TouchPointerState aPointerState,
+                                             LayoutDeviceIntPoint aPoint,
+                                             TimeStamp aTimeStamp) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!mDirectTouchInput) {
+    mDirectTouchInput = MakeUnique<MultiTouchInput>();
+  }
+  // Touchscreens don't report pressure; use the Pointer Events default for an
+  // active pointer without pressure support.
+  MultiTouchInput inputToDispatch =
+      UpdateSynthesizedTouchState(mDirectTouchInput.get(), aTimeStamp,
+                                  aPointerId, aPointerState, aPoint, 0.5, 0);
+  DispatchTouchInput(inputToDispatch);
+}
